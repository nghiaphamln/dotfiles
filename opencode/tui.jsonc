{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "system",
  "diff_style": "stacked",
  "mouse": true,
  "scroll_acceleration": {
    "enabled": true
  },
  "prompt": {
    "max_width": "auto"
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.35,
    "sound_pack": "opencode.default"
  }
}
