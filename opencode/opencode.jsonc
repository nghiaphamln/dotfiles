{
  "$schema": "https://opencode.ai/config.json",
  "model": "aicheap/gpt-6.2-sol",
  "agents": {
    "title": {
      "model": "aicheap/gpt-6-luna"
    }
  },
  "snapshots": true,
  "share": "manual",
  "formatter": true,
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 32768
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      ".cache/**"
    ]
  },
  "providers": {
    "aicheap": {
      "package": "@opencode/ai/providers/openai",
      "name": "AI Cheap Provider",
      "settings": {
        "baseURL": "{env:AI_CHEAP_BASE_URL}",
        "apiKey": "{env:AI_CHEAP_API_KEY}"
      },
      "models": {
        "gpt-6.2-sol": {
          "name": "GPT 6.2 Sol",
          "capabilities": {
            "tools": true,
            "temperature": false,
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "xhigh", "max"]
            },
            "input": ["text", "image"],
            "output": ["text"]
          },
          "settings": {
            "reasoningEffort": "high",
            "reasoningSummary": "detailed",
            "textVerbosity": "medium"
          },
          "variants": [
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max",
                "reasoningSummary": "detailed",
                "textVerbosity": "medium"
              }
            }
          ],
          "cost": [
            {
              "input": 2,
              "output": 10,
              "cache": {
                "read": 0.1,
                "write": 2.5
              }
            },
            {
              "tier": {
                "type": "context",
                "size": 272000
              },
              "input": 4,
              "output": 15,
              "cache": {
                "read": 0.2,
                "write": 5
              }
            }
          ],
          "limit": {
            "context": 872000,
            "input": 744000,
            "output": 128000
          }
        },
        "gpt-6.2-astra": {
          "name": "GPT 6.2 Astra",
          "capabilities": {
            "tools": true,
            "temperature": false,
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "xhigh", "max"]
            },
            "input": ["text", "image"],
            "output": ["text"]
          },
          "settings": {
            "reasoningEffort": "max",
            "reasoningSummary": "detailed",
            "textVerbosity": "medium"
          },
          "variants": [
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max",
                "reasoningSummary": "detailed",
                "textVerbosity": "medium"
              }
            }
          ],
          "cost": [
            {
              "input": 8,
              "output": 40,
              "cache": {
                "read": 0.4,
                "write": 10
              }
            },
            {
              "tier": {
                "type": "context",
                "size": 272000
              },
              "input": 16,
              "output": 60,
              "cache": {
                "read": 0.8,
                "write": 20
              }
            }
          ],
          "limit": {
            "context": 872000,
            "input": 744000,
            "output": 128000
          }
        },
        "gpt-6.1-terra": {
          "name": "GPT 6.1 Terra",
          "capabilities": {
            "tools": true,
            "temperature": false,
            "reasoning": {
              "supported": true,
              "effort": ["none", "low", "medium", "high", "xhigh", "max"]
            },
            "input": ["text", "image"],
            "output": ["text"]
          },
          "settings": {
            "reasoningEffort": "max",
            "reasoningSummary": "detailed",
            "textVerbosity": "medium"
          },
          "variants": [
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max",
                "reasoningSummary": "detailed",
                "textVerbosity": "medium"
              }
            }
          ],
          "cost": [
            {
              "input": 1,
              "output": 5,
              "cache": {
                "read": 0.05,
                "write": 1.25
              }
            },
            {
              "tier": {
                "type": "context",
                "size": 272000
              },
              "input": 2,
              "output": 7.5,
              "cache": {
                "read": 0.1,
                "write": 2.5
              }
            }
          ],
          "limit": {
            "context": 872000,
            "input": 744000,
            "output": 128000
          }
        },
        "gpt-6-luna": {
          "name": "GPT 6 Luna",
          "capabilities": {
            "tools": true,
            "temperature": false,
            "reasoning": {
              "supported": true,
              "effort": ["none", "low", "medium", "high", "xhigh", "max"]
            },
            "input": ["text", "image"],
            "output": ["text"]
          },
          "settings": {
            "reasoningEffort": "low",
            "reasoningSummary": "auto",
            "textVerbosity": "medium"
          },
          "variants": [
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            }
          ],
          "cost": [
            {
              "input": 0.1,
              "output": 0.5,
              "cache": {
                "read": 0.01,
                "write": 0.125
              }
            },
            {
              "tier": {
                "type": "context",
                "size": 272000
              },
              "input": 0.2,
              "output": 0.75,
              "cache": {
                "read": 0.02,
                "write": 0.25
              }
            }
          ],
          "limit": {
            "context": 872000,
            "input": 744000,
            "output": 128000
          }
        }
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail@5.3.2"
  ]
}
