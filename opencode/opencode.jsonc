{
  "$schema": "https://opencode.ai/config.json",
  "model": "aicheap/gpt-6.1-sol",
  "agents": {
    "title": {
      "model": "aicheap/gpt-6-luna"
    }
  },
  "snapshots": true,
  "share": "manual",
  "formatter": true,
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 32768
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      ".cache/**"
    ]
  },
  "providers": {
    "aicheap": {
      "package": "@opencode/ai/providers/openai",
      "name": "AI Cheap Provider",
      "settings": {
        "baseURL": "{env:AI_CHEAP_BASE_URL}",
        "apiKey": "{env:AI_CHEAP_API_KEY}"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT 6.1 Sol",
          "capabilities": {
            "tools": true,
            "temperature": false,
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "xhigh", "max"]
            },
            "input": ["text", "image"],
            "output": ["text"]
          },
          "settings": {
            "reasoningEffort": "high",
            "reasoningSummary": "detailed",
            "textVerbosity": "medium"
          },
          "variants": [
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max",
                "reasoningSummary": "detailed",
                "textVerbosity": "medium"
              }
            }
          ],
          "cost": [
            {
              "input": 2,
              "output": 10,
              "cache": {
                "read": 0.1,
                "write": 2.5
              }
            },
            {
              "tier": {
                "type": "context",
                "size": 272000
              },
              "input": 4,
              "output": 15,
              "cache": {
                "read": 0.2,
                "write": 5
              }
            }
          ],
          "limit": {
            "context": 872000,
            "input": 744000,
            "output": 128000
          }
        },
        "gpt-6-astra": {
          "name": "GPT 6 Astra",
          "capabilities": {
            "tools": true,
            "temperature": false,
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "xhigh", "max"]
            },
            "input": ["text", "image"],
            "output": ["text"]
          },
          "settings": {
            "reasoningEffort": "max",
            "reasoningSummary": "detailed",
            "textVerbosity": "medium"
          },
          "variants": [
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max",
                "reasoningSummary": "detailed",
                "textVerbosity": "medium"
              }
            }
          ],
          "cost": [
            {
              "input": 10,
              "output": 50,
              "cache": {
                "read": 1,
                "write": 12.5
              }
            },
            {
              "tier": {
                "type": "context",
                "size": 272000
              },
              "input": 20,
              "output": 75,
              "cache": {
                "read": 2,
                "write": 25
              }
            }
          ],
          "limit": {
            "context": 872000,
            "input": 744000,
            "output": 128000
          }
        },
        "gpt-6-luna": {
          "name": "GPT 6 Luna",
          "capabilities": {
            "tools": true,
            "temperature": false,
            "reasoning": {
              "supported": true,
              "effort": ["none", "low", "medium", "high", "xhigh", "max"]
            },
            "input": ["text", "image"],
            "output": ["text"]
          },
          "settings": {
            "reasoningEffort": "low",
            "reasoningSummary": "auto",
            "textVerbosity": "medium"
          },
          "variants": [
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max",
                "reasoningSummary": "auto",
                "textVerbosity": "medium"
              }
            }
          ],
          "cost": [
            {
              "input": 0.1,
              "output": 0.5,
              "cache": {
                "read": 0.01,
                "write": 0.125
              }
            },
            {
              "tier": {
                "type": "context",
                "size": 272000
              },
              "input": 0.2,
              "output": 0.75,
              "cache": {
                "read": 0.02,
                "write": 0.25
              }
            }
          ],
          "limit": {
            "context": 872000,
            "input": 744000,
            "output": 128000
          }
        }
      }
    },
    "antigravity": {
      "package": "@opencode/ai/providers/google",
      "name": "Antigravity",
      "settings": {
        "baseURL": "{env:LLM_BASE_URL}/v1beta",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "gemini-3.7-flash-high": {
          "name": "Gemini 3.7 Flash (High)",
          "capabilities": {
            "tools": true,
            "reasoning": {
              "supported": true
            },
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-pro-agent": {
          "name": "Gemini 3.1 Pro (High)",
          "capabilities": {
            "tools": true,
            "reasoning": {
              "supported": true
            },
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 65535
          }
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Thinking)",
          "capabilities": {
            "tools": true,
            "reasoning": {
              "supported": true
            },
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 (Thinking)",
          "capabilities": {
            "tools": true,
            "reasoning": {
              "supported": true
            },
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 64000
          }
        }
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail@5.3.2",
    "github:with-pebbly/aseprite-ai-artist#5894b12cead839789077b279369409f868451ffc::path:opencode"
  ],
  "mcp": {
    "servers": {
      "aseprite-ai-artist": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@pebbly/aseprite-ai-artist@0.8.2",
          "serve"
        ],
        "environment": {
          "ASEPRITE_AI_PROMPTS": "0"
        }
      }
    }
  }
}
