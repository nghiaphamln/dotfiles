{
  "$schema": "https://opencode.ai/config.json",
  "model": "aicheap/gpt-5.6-sol",
  "small_model": "aicheap/gpt-5.6-luna",
  "snapshot": true,
  "share": "manual",
  "lsp": true,
  "formatter": true,
  "instructions": [
    "skills/iron-laws.md"
  ],
  "plugin": [],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 32768
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      ".cache/**"
    ]
  },
  "provider": {
    "aicheap": {
      "npm": "@ai-sdk/openai",
      "name": "AI Cheap Provider",
      "options": {
        "baseURL": "{env:AI_CHEAP_BASE_URL}",
        "apiKey": "{env:AI_CHEAP_API_KEY}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "detailed",
            "textVerbosity": "medium"
          },
          "cost": {
            "input": 5,
            "output": 30,
            "cache_read": 0.5,
            "cache_write": 6.25
          },
          "limit": {
            "context": 372000,
            "output": 128000
          },
          "modalities": {
            "input": [
