{
  "$schema": "https://opencode.ai/config.json",
  "model": "aicheap/gpt-5.6-terra",
  "small_model": "aicheap/gpt-5.6-luna",
  "snapshot": true,
  "share": "manual",
  "lsp": true,
  "formatter": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 32768
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      ".cache/**"
    ]
  },
  "provider": {
    "aicheap": {
      "npm": "@ai-sdk/openai",
      "name": "AI Cheap Provider",
      "options": {
        "baseURL": "{env:AI_CHEAP_BASE_URL}",
        "apiKey": "{env:AI_CHEAP_API_KEY}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "detailed",
            "textVerbosity": "medium"
          },
          "variants": {
            "max": {
              "reasoningEffort": "max",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          },
          "cost": {
            "input": 5,
            "output": 30,
            "cache_read": 0.5,
            "cache_write": 6.25
          },
          "limit": {
            "context": 372000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra",
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "options": {
            "reasoningEffort": "max",
            "reasoningSummary": "detailed",
            "textVerbosity": "medium"
          },
          "variants": {
            "max": {
              "reasoningEffort": "max",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          },
          "cost": {
            "input": 2,
            "output": 12,
            "cache_read": 0.2,
            "cache_write": 2.5
          },
          "limit": {
            "context": 372000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna",
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "options": {
            "reasoningEffort": "low",
            "reasoningSummary": "auto",
            "textVerbosity": "medium"
          },
          "variants": {
            "max": {
              "reasoningEffort": "max",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            }
          },
          "cost": {
            "input": 0.2,
            "output": 1.2,
            "cache_read": 0.02,
            "cache_write": 0.25
          },
          "limit": {
            "context": 372000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "antigravity": {
      "npm": "@ai-sdk/google",
      "name": "Antigravity",
      "options": {
        "baseURL": "{env:LLM_BASE_URL}/v1beta",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "gemini-3.7-flash-high": {
          "name": "Gemini 3.7 Flash (High)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true
        },
        "gemini-pro-agent": {
          "name": "Gemini 3.1 Pro (High)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Thinking)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true
        },
        "claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 (Thinking)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true
        }
      }
    }
  }
}
